{
  "name": "cql22",
  "displayName": "CQL 22",
  "description": "Syntax highlighting for .cql files",
  "publisher": "DanielCraciun",
  "author": {
    "name": "CQL 22"
  },
  "version": "0.0.7",
  "engines": {
    "vscode": ">=1.50.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [{
      "id": "cql",
      "aliases": ["cql", "CQL"],
      "extensions": [".cql"],
      "configuration": "./language-configuration.json"
    }],
    "grammars": [{
      "language": "cql",
      "scopeName": "source.cql",
      "path": "./syntaxes/cql.tmLanguage.json"
    }]
  }
}
