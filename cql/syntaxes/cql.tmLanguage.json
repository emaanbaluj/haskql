{
	"fileTypes": ["cql"],
	"name": "CQL",
	"scopeName": "source.cql",
	"patterns": [
	  {
		"name": "keyword.control.cql",
		"match": "\\b(?:IMPORT|SET|UPDATE|WITH|WRITE|PRINT|WHERE|MAP|INSERT|COL|ROW|TRANSPOSE|GET|CROSS|ZIP|STACK|FILTER|DISTINCT|UNION|LIMIT|CONCAT|REPLACE|REVERSE|LEFT_MERGE|RIGHT_MERGE)\\b"
	  },
	  {
		"name": "comment.line.double-dash",
		"match": "--.*$",
		"captures": {
		  "0": {
			"name": "comment.line.double-dash"
		  }
		}
	  },	  
	  {
		"name": "keyword.operator.cql",
		"match": "\\b(?:SORT|TO|ON)\\b"
	  },
	  {
		"name": "storage.modifier.cql",
		"match": "\\b(?:AS|IN)\\b"
	  },
	  {
		"name": "invalid.illegal.cql",
		"match": "\\b(?:NULL)\\b"
	  },
	  {
		"name": "support.function.cql",
		"match": "\\b(?:UPPER|LOWER|ARITY)\\b"
	  },
	  {
		"name": "constant.language.boolean.cql",
		"match": "\\b(?:NOSORT|NOTRIM|NOT|IS)\\b"
	  },
	  {
		"name": "constant.numeric.float.cql",
		"match": "\\b\\d+\\.\\d+\\b"
	  },
	  {
		"name": "constant.numeric.integer.cql",
		"match": "\\b\\d+\\b"
	  },
	  {
		"name": "string.quoted.double.cql",
		"begin": "\"",
		"beginCaptures": {
		  "0": { "name": "punctuation.definition.string.begin.cql" }
		},
		"end": "\"",
		"endCaptures": {
		  "0": { "name": "punctuation.definition.string.end.cql" }
		},
		"patterns": [
		  {
			"name": "constant.character.escape.cql",
			"match": "\\\\."
		  }
		]
	  },
	  {
		"name": "variable.parameter.cql",
		"match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
	  },
	  {
		"name": "variable.language.cql",
		"match": "\\$"
	  },
	  {
		"name": "punctuation.separator.comma.cql",
		"match": ","
	  },
	  {
		"name": "punctuation.terminator.statement.cql",
		"match": ";"
	  },
	  {
		"name": "punctuation.section.parens.begin.cql",
		"match": "\\("
	  },
	  {
		"name": "punctuation.section.parens.end.cql",
		"match": "\\)"
	  },
	  {
		"name": "punctuation.accessor.cql",
		"match": "\\."
	  },
	  {
		"name": "keyword.operator.assignment.cql",
		"match": "="
	  },
	  {
		"name": "keyword.operator.arithmetic.cql",
		"match": "\\+|-|\\*|/"
	  },
	  {
		"name": "keyword.operator.comparison.cql",
		"match": "\\|\\||&&|==|!=|<=|>=|<|>|\\$"
	  }
	],
	"repository": {}
  }
  